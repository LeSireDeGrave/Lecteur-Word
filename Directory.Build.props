<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Version Condition="'$(Version)' == '' and '$(LecteurWordReleaseCandidate)' == 'true'">1.0.0-rc.1</Version><Version Condition="'$(Version)' == ''">0.1.0</Version><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><Deterministic>true</Deterministic><PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap><RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion><NuGetAudit>true</NuGetAudit></PropertyGroup>
  <PropertyGroup>
    <Authors>LeSireDeGrave</Authors>
    <Copyright>Copyright (c) 2026 LeSireDeGrave</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/LeSireDeGrave/Lecteur-Word</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
</Project>
