{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest-v1.schema.json",
  "title": "Lecteur Word extension manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "author", "version", "compatibility", "apiVersion", "features", "permissions", "license", "provenance", "payloadSha256"],
  "properties": {
    "id": {"$ref": "#/$defs/id"},
    "name": {"$ref": "#/$defs/text", "maxLength": 90},
    "description": {"$ref": "#/$defs/text", "maxLength": 600},
    "author": {"$ref": "#/$defs/text", "maxLength": 120},
    "version": {"$ref": "#/$defs/version"},
    "compatibility": {"$ref": "#/$defs/range"},
    "apiVersion": {"const": 1},
    "features": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {"enum": ["appearance.theme", "appearance.translation", "reading.metrics", "reading.navigation", "reading.accessibility"]}
    },
    "permissions": {"type": "array"},
    "license": {"$ref": "#/$defs/text", "maxLength": 100},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["publisher"],
      "properties": {
        "publisher": {"$ref": "#/$defs/text", "maxLength": 120},
        "source": {"anyOf": [{"$ref": "#/$defs/https"}, {"type": "null"}]}
      }
    },
    "payloadSha256": {"$ref": "#/$defs/sha256"},
    "dependencies": {
      "type": ["array", "null"], "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "minimum", "maximumExclusive"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "minimum": {"$ref": "#/$defs/version"},
          "maximumExclusive": {"$ref": "#/$defs/version"}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"features": {"const": ["reading.metrics"]}}}, "then": {"properties": {"permissions": {"const": ["document.metrics.read"]}}}},
    {"if": {"properties": {"features": {"const": ["reading.navigation"]}}}, "then": {"properties": {"permissions": {"const": ["document.navigation"]}}}},
    {"if": {"properties": {"features": {"enum": [["appearance.theme"], ["appearance.translation"], ["reading.accessibility"]]}}}, "then": {"properties": {"permissions": {"const": []}}}}
  ],
  "$defs": {
    "id": {"type": "string", "maxLength": 80, "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "version": {"type": "string", "maxLength": 32, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "range": {
      "type": "object", "additionalProperties": false, "required": ["minimum", "maximumExclusive"],
      "properties": {"minimum": {"$ref": "#/$defs/version"}, "maximumExclusive": {"$ref": "#/$defs/version"}}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "https": {"type": "string", "format": "uri", "pattern": "^[Hh][Tt][Tt][Pp][Ss]://"}
  }
}
